# Compiled class files
*.class

# Log files
*.log
logs/

# Package Files (Executables and Fat JARs)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven target build output
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
